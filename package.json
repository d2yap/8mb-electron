{
  "name": "8mb",
  "version": "0.1.1",
  "main": "main/main.js",
  "scripts": {
    "start": "electron .",
    "dev:renderer": "cd src/renderer && vite",
    "dev:electron": "wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .",
    "dev": "concurrently \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "cd src/renderer && vite build",
    "build": "npm run build:renderer && electron-builder"
  },
  "build": {
    "appId": "com.github.d2yap",
    "productName": "8mb",
    "files": [
      "main/",
      "variables/",
      "css/",
      "loading.html",
      "preload.js",
      "qr.html",
      "dist/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "build/icon.ico"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "description": "",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@mantine/core": "^7.17.8",
    "@mantine/hooks": "^7.17.8",
    "electron-log": "^5.4.1",
    "express": "^5.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "https": "^1.0.0",
    "qrcode": "^1.5.4",
    "unzipper": "^0.12.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "electron": "^41.5.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.14",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^4.2.4",
    "vite": "^7.0.0",
    "wait-on": "^7.0.1"
  }
}
